rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function owner(uid) {
      return signedIn()
        && request.auth.uid == uid;
    }

    function userData(uid) {
      return get(
        /databases/$(database)/documents/users/$(uid)
      ).data;
    }

    function paidPublisher(uid) {
      return userData(uid).plan == 'pro'
        || userData(uid).plan == 'business';
    }

    function verifiedMunicipality(uid) {
      return userData(uid).profileType == 'public'
        && userData(uid).organizationType == 'municipality'
        && userData(uid).municipalityVerificationStatus == 'verified';
    }

    function canPublishPublic(uid) {
      return paidPublisher(uid)
        || verifiedMunicipality(uid);
    }

    /*
     * Public Cirilo ID ownership.
     */
    function ownsPublicCiriloId(ciriloId) {
      return signedIn()
        && userData(request.auth.uid).ciriloId == ciriloId;
    }

    /*
     * Personal / Company / Public non-verified:
     * free profile switching.
     *
     * Verified municipality:
     * locked to Public + Municipality.
     */
    function validUserSelfUpdate() {
      let wasVerifiedMunicipality =
        resource.data.get(
          'municipalityVerificationStatus',
          'unverified'
        ) == 'verified'
        &&
        resource.data.get(
          'profileType',
          'personal'
        ) == 'public'
        &&
        resource.data.get(
          'organizationType',
          ''
        ) == 'municipality';

      let keepsMunicipalityIdentity =
        request.resource.data.get(
          'profileType',
          'personal'
        ) == 'public'
        &&
        request.resource.data.get(
          'organizationType',
          ''
        ) == 'municipality';

      let protectedFieldsUnchanged =
        request.resource.data.get(
          'plan',
          'free'
        )
        ==
        resource.data.get(
          'plan',
          'free'
        )

        &&

        request.resource.data.get(
          'stripeCustomerId',
          ''
        )
        ==
        resource.data.get(
          'stripeCustomerId',
          ''
        )

        &&

        request.resource.data.get(
          'stripeSubscriptionId',
          ''
        )
        ==
        resource.data.get(
          'stripeSubscriptionId',
          ''
        )

        &&

        request.resource.data.get(
          'stripeSubscriptionStatus',
          ''
        )
        ==
        resource.data.get(
          'stripeSubscriptionStatus',
          ''
        )

        &&

        request.resource.data.get(
          'municipalityVerificationStatus',
          'unverified'
        )
        ==
        resource.data.get(
          'municipalityVerificationStatus',
          'unverified'
        )

        &&

        request.resource.data.get(
          'municipalityVerifiedAt',
          null
        )
        ==
        resource.data.get(
          'municipalityVerifiedAt',
          null
        )

        &&

        request.resource.data.get(
          'municipalityVerifiedBy',
          ''
        )
        ==
        resource.data.get(
          'municipalityVerifiedBy',
          ''
        )

        &&

        request.resource.data.get(
          'municipalityRejectedAt',
          null
        )
        ==
        resource.data.get(
          'municipalityRejectedAt',
          null
        )

        &&

        request.resource.data.get(
          'municipalityRejectedBy',
          ''
        )
        ==
        resource.data.get(
          'municipalityRejectedBy',
          ''
        );

      return protectedFieldsUnchanged
        &&
        (
          !wasVerifiedMunicipality
          ||
          keepsMunicipalityIdentity
        );
    }

    function validPublicUserSelfUpdate() {
      return request.resource.data
        .diff(resource.data)
        .affectedKeys()
        .hasNone([
          'municipalityVerificationStatus',
          'municipalityVerifiedAt',
          'municipalityVerifiedBy'
        ]);
    }

    function threadExists(threadId) {
      return threadId is string
        && threadId.size() > 0
        && exists(
          /databases/$(database)/documents/sharedThreads/$(threadId)
        );
    }

    function threadData(threadId) {
      return get(
        /databases/$(database)/documents/sharedThreads/$(threadId)
      ).data;
    }

    function receivedNote(data) {
      return data.get(
        'isReceivedShared',
        false
      ) == true
        || data.get(
          'lockedForRecipient',
          false
        ) == true
        || data.get(
          'receivedSnapshot',
          false
        ) == true;
    }

    function validInboxLocalUpdate() {
      return request.resource.data
        .diff(resource.data)
        .affectedKeys()
        .hasOnly([
          'status',
          'archived',
          'archivedAt',
          'archiveType',
          'read',
          'readAt',
          'lastReplyAt',
          'updatedAt'
        ]);
    }

    function validReceivedNoteLocalUpdate() {
      return request.resource.data
        .diff(resource.data)
        .affectedKeys()
        .hasOnly([
          'archived',
          'archivedAt',
          'updatedAt'
        ]);
    }

    function validNoteShareCreate(uid) {
      return signedIn()
        && request.resource.data.type == 'note_share'
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.threadId is string
        && threadExists(request.resource.data.threadId)
        && threadData(request.resource.data.threadId).closed == false
        && request.resource.data.sharePolicy
          == threadData(request.resource.data.threadId).sharePolicy
        && request.resource.data.originalSenderUid
          == threadData(request.resource.data.threadId).originalSenderUid
        && request.resource.data.originalSenderCiriloId
          == threadData(request.resource.data.threadId).originalSenderCiriloId
        && request.resource.data.organizerUid
          == threadData(request.resource.data.threadId).organizerUid
        && request.resource.data.organizerCiriloId
          == threadData(request.resource.data.threadId).organizerCiriloId
        && (
          request.auth.uid
            == threadData(request.resource.data.threadId).organizerUid
          ||
          threadData(request.resource.data.threadId).sharePolicy
            == 'shareable'
        );
    }

    function validReplyInboxCreate(uid) {
      return signedIn()
        && request.resource.data.type == 'reply'
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.recipientUid == uid
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 5000
        && (
          !(
            request.resource.data.threadId is string
            && request.resource.data.threadId.size() > 0
          )
          ||
          (
            request.resource.data.threadId is string
            && request.resource.data.threadId.size() > 0
            && threadExists(request.resource.data.threadId)
            && threadData(request.resource.data.threadId).closed == false
          )
        );
    }

    function validLocalReplyCopyCreate(uid) {
      return signedIn()
        && request.auth.uid == uid
        && request.resource.data.type == 'reply_sent'
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.localCopy == true
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 5000;
    }

    function validTambaAssignedCopyCreate(uid, jobId) {
      return signedIn()
        && request.auth.uid != uid
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.assignedToUid == uid
        && request.resource.data.sourceOwnerUid == request.auth.uid
        && request.resource.data.sourceJobId == jobId
        && request.resource.data.localCopy == true;
    }

    function validTambaAssigneeOperationalUpdate() {
      return signedIn()
        && resource.data.assignedToUid == request.auth.uid
        && request.resource.data.assignedToUid
          == resource.data.assignedToUid
        && request.resource.data.createdByUid
          == resource.data.createdByUid
        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'status',
            'checklist',
            'notes',
            'proofPhotoUrl',
            'startedAt',
            'completedAt',
            'updatedAt'
          ]);
    }

    function validTambaCreatorUpdate() {
      return signedIn()
        && resource.data.createdByUid == request.auth.uid;
    }

    match /users/{uid} {

      allow read, delete: if owner(uid);

      allow create: if owner(uid)
        && request.resource.data.plan == 'free'
        && request.resource.data.get(
          'municipalityVerificationStatus',
          'unverified'
        ) != 'verified';

      allow update: if owner(uid)
        && validUserSelfUpdate();

      /*
       * Calendar events
       */
      match /events/{eventId} {
        allow read, write: if owner(uid);
      }

      /*
       * Cirilo contacts
       *
       * Used by invite picker / recent contacts.
       */
      match /contacts/{contactId} {
        allow read, create, update, delete: if owner(uid);
      }

      /*
       * Cirilo teams
       *
       * Used by invite picker / team management.
       */
      match /teams/{teamId} {
        allow read, create, update, delete: if owner(uid);
      }

      /*
       * Notes
       */
      match /notes/{noteId} {

        allow read: if owner(uid);

        allow create: if owner(uid);

        allow update: if owner(uid)
          && (
            !receivedNote(resource.data)
            ||
            validReceivedNoteLocalUpdate()
          );

        allow delete: if owner(uid);
      }

      /*
       * Inbox
       */
      match /inbox/{itemId} {

        allow read: if owner(uid);

        allow update: if owner(uid)
          && validInboxLocalUpdate();

        allow delete: if owner(uid);

        allow create: if signedIn()
          && (
            (
              request.resource.data.type == 'event_share'
              && request.resource.data.senderUid == request.auth.uid
            )
            ||
            validNoteShareCreate(uid)
            ||
            validReplyInboxCreate(uid)
            ||
            validLocalReplyCopyCreate(uid)
            ||
            (
              request.resource.data.type == 'note_reminder'
              && request.auth.uid == uid
            )
          );
      }

      /*
       * Tamba jobs
       */
      match /tambaJobs/{jobId} {

        allow read: if owner(uid);

        allow create: if
          (
            owner(uid)
            && request.resource.data.createdByUid == request.auth.uid
          )
          ||
          validTambaAssignedCopyCreate(uid, jobId);

        allow update: if
          (
            owner(uid)
            && resource.data.get(
              'localCopy',
              false
            ) != true
          )
          ||
          validTambaCreatorUpdate()
          ||
          validTambaAssigneeOperationalUpdate();

        allow delete: if
          owner(uid)
          ||
          (
            signedIn()
            && resource.data.createdByUid == request.auth.uid
          );
      }

      /*
       * Tamba templates
       */
      match /tambaTemplates/{templateId} {
        allow read, create, update, delete: if owner(uid);
      }

      /*
       * Talents
       */
      match /talents/{talentId} {
        allow read, create, update, delete: if owner(uid);
      }
    }

    /*
     * Public profile mirror.
     */
    match /publicUsers/{ciriloId} {

      allow read: if true;

      allow create: if ownsPublicCiriloId(ciriloId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.ciriloId == ciriloId
        && request.resource.data.get(
          'municipalityVerificationStatus',
          'unverified'
        ) != 'verified';

      allow update: if ownsPublicCiriloId(ciriloId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.ciriloId == ciriloId
        && validPublicUserSelfUpdate();

      allow delete: if ownsPublicCiriloId(ciriloId);
    }

    /*
     * Municipality verification.
     * Readable by owner.
     * Written only by trusted backend/admin logic.
     */
    match /organizationVerifications/{uid} {
      allow read: if owner(uid);
      allow create, update, delete: if false;
    }

    /*
     * Cirilo ID reservation
     */
    match /ciriloIds/{ciriloId} {

      allow get: if signedIn();

      allow list: if false;

      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid;

      allow update, delete: if false;
    }

    /*
     * Shared event cards
     */
    match /sharedCards/{token} {

      allow read: if resource.data.visibility == 'shared'
        && resource.data.revoked == false;

      allow create: if signedIn()
        && request.resource.data.senderUid == request.auth.uid;

      allow update, delete: if signedIn()
        && resource.data.senderUid == request.auth.uid;
    }

    /*
     * Shared notes
     */
    match /sharedNotes/{token} {

      allow read: if resource.data.revoked == false;

      allow create: if signedIn()
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.threadId is string
        && threadExists(request.resource.data.threadId)
        && threadData(request.resource.data.threadId).closed == false
        && request.resource.data.sharePolicy
          == threadData(request.resource.data.threadId).sharePolicy
        && (
          request.auth.uid
            == threadData(request.resource.data.threadId).organizerUid
          ||
          threadData(request.resource.data.threadId).sharePolicy
            == 'shareable'
        );

      allow update, delete: if false;
    }

    /*
     * Shared conversation threads
     */
    match /sharedThreads/{threadId} {

      allow get: if signedIn();

      allow list: if false;

      allow create: if signedIn()
        && request.resource.data.organizerUid == request.auth.uid
        && request.resource.data.originalSenderUid == request.auth.uid
        && request.resource.data.closed == false
        && (
          request.resource.data.sharePolicy == 'private'
          ||
          request.resource.data.sharePolicy == 'shareable'
        );

      allow update: if signedIn()
        && (
          (
            resource.data.closed == false
            && request.resource.data
              .diff(resource.data)
              .affectedKeys()
              .hasOnly([
                'updatedAt'
              ])
          )
          ||
          (
            request.auth.uid == resource.data.organizerUid
            && resource.data.closed == false
            && request.resource.data.closed == true
            && request.resource.data.closedByUid == request.auth.uid
            && request.resource.data
              .diff(resource.data)
              .affectedKeys()
              .hasOnly([
                'closed',
                'closedByUid',
                'closedByCiriloId',
                'closedAt',
                'updatedAt'
              ])
          )
        );

      allow delete: if false;

      match /replies/{replyId} {

        allow read: if signedIn();

        allow create: if signedIn()
          && request.resource.data.senderUid == request.auth.uid
          && exists(
            /databases/$(database)/documents/sharedThreads/$(threadId)
          )
          && get(
            /databases/$(database)/documents/sharedThreads/$(threadId)
          ).data.closed == false;

        allow update, delete: if false;
      }
    }

    /*
     * Public events
     *
     * Allowed for:
     * - Pro
     * - Business
     * - Verified municipality
     */
    match /publicEvents/{eventId} {

      allow read: if true;

      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && canPublishPublic(request.auth.uid);

      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid
        && canPublishPublic(request.auth.uid);

      allow delete: if signedIn()
        && resource.data.ownerUid == request.auth.uid;
    }

    /*
     * Public channels
     */
    match /channels/{channelId} {

      allow read: if true;

      allow write: if signedIn();
    }
  }
}